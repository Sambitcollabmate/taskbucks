storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_KEY_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
storeFile=REPLACE_WITH_ABSOLUTE_OR_RELATIVE_PATH_TO_KEYSTORE_JKS
# A relative path here resolves against android/ (this file's own
# directory) — e.g. `storeFile=earnbucks-release.jks` if the keystore
# sits right next to key.properties, as it does by default.
