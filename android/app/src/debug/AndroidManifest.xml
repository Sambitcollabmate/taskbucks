<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only cleartext exception so the app can hit the local Laravel
         dev server over plain http:// (Android blocks cleartext by default
         since API 28). See res/xml/network_security_config.xml for the
         allow-listed dev hosts. Merged into the debug build's application
         tag only; release builds are unaffected. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
