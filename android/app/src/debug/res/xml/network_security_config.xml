<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only: allows plain http:// to the local `php artisan serve` backend.
     10.0.2.2 is the Android emulator's alias for the host machine's localhost;
     192.168.29.116 is the dev machine's current LAN IP, needed when testing
     against a physical device on the same Wi-Fi network (update this if the
     PC's IP changes, e.g. after reconnecting to Wi-Fi; check with `ipconfig`).
     This file lives under src/debug so it never ships in a release build. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.29.116</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
